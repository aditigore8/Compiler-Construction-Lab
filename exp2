
%{
#include<stdio.h>
int comments=0, keywords=0, identifiers=0;
int words=0, lines=0, spaces=0;
%}

ID [a-zA-Z_][a-zA-Z0-9_]*

%%
"//".*                         {comments++;}
"/*"([^*]|\*+[^*/])*\*+"/"     {comments++;}
"auto"|"break"|"case"|"char"|"const"|"continue"|"default"|"do"|"double"|"else"|"enum"|"extern"|"float"|"for"|"goto"|"if"|"int"|"long"|"register"|"return"|"short"|"signed"|"sizeof"|"static"|"struct"|"switch"|"typedef"|"union"|"unsigned"|"void"|"volatile"|"while" {keywords++; words++;}
{ID}                           {identifiers++; words++;}
[0-9]+                         {words++;}
[ ]                            {spaces++;}
\n                             {lines++;}
.                              ;
%%

int main()
{
    yylex();
    printf("\nComments = %d",comments);
    printf("\nKeywords = %d",keywords);
    printf("\nIdentifiers = %d",identifiers);
    printf("\nWords = %d",words);
    printf("\nLines = %d",lines);
    printf("\nSpaces = %d\n",spaces);
    return 0;
}

int yywrap()
{
    return 1;
}
